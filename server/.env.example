# Postgres connection (read automatically by the pg package)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Set to "require" for a hosted Postgres (e.g. Render) that needs SSL; leave unset for local Postgres.
PGSSLMODE=

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the callback URL registered on the GitHub OAuth App.
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Session
SESSION_SECRET=

# Client app origin, used for CORS and the post-login redirect.
CLIENT_URL=http://localhost:5173

# Set to "production" when deployed; enables secure cross-domain session cookies.
NODE_ENV=

PORT=3001
